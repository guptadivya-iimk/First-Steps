rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and subcollections isolation
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Service areas: public read for authenticated users, admin write
    match /areas/{areaId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Schools & fact subcollections: public read for signed-in users, admin write
    match /schools/{schoolId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.admin == true;
      
      match /facts/{factKey} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.token.admin == true;
      }
    }
    
    // Suggestions queue: users can create suggestions, admins can review/write
    match /suggestions/{suggestionId} {
      allow create: if request.auth != null;
      allow read, update, delete: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Audit logs: admin only
    match /auditLog/{logId} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // Anonymised seat inquiries
    match /seatInquiries/{inquiryId} {
      allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
